import pandas as pd
import numpy as np

# Load the standardized data
data = pd.read_csv('/content/data_step1_scaled.csv', index_col='Date', parse_dates=True)

# Make a copy for adding new features
features = data.copy()

# ---- Example Feature Engineering ----
# 1. Common Spreads (assumes columns exist)
try:
    features['2s10s'] = data['ust10y'] - data['ust2y']
    features['5s30s'] = data['ust30y'] - data['ust5y']
    features['2s5s'] = data['ust5y'] - data['ust2y']
except KeyError:
    print("Some curve columns for spreads are missing.")

# 2. Curvature (Butterfly: (10y-2y) - (2y-1m))
try:
    features['butterfly_10s2s1m'] = (data['ust10y'] - data['ust2y']) - (data['ust2y'] - data['ust1m'])
except KeyError:
    print("Some curve columns for curvature are missing.")

# 3. Momentum (20-day diff of 10y yield and 2s10s spread)
features['mom_10y'] = data['ust10y'].diff(20)
features['mom_2s10s'] = features['2s10s'].diff(20)

# 4. Rolling Volatility (20-day std dev)
features['vol_10y'] = data['ust10y'].rolling(window=20).std()
features['vol_2s10s'] = features['2s10s'].rolling(window=20).std()

# Drop rows with NaNs from diff and rolling
features.dropna(inplace=True)

# Save for next step
features.to_csv('/content/data_step2_features.csv')

print("✅ Step 2 completed. Feature matrix shape:", features.shape)
