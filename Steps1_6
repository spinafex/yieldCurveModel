# Step 3: PCA - Dimensionality Reduction
import pandas as pd
import numpy as np
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler

# Load feature data
data = pd.read_csv('/content/data_step2_features.csv', parse_dates=['Date'])
data.set_index('Date', inplace=True)

# Optional: re-standardize (recommended before PCA)
scaler = StandardScaler()
data_scaled = pd.DataFrame(scaler.fit_transform(data),
                           columns=data.columns,
                           index=data.index)

# Apply PCA
n_components = 3
pca = PCA(n_components=n_components)
principal_components = pca.fit_transform(data_scaled)

# Create DataFrame with PCs
pca_df = pd.DataFrame(principal_components,
                      columns=[f'PC{i+1}' for i in range(n_components)],
                      index=data.index)

# Merge PCs back into original feature data
data_with_pca = data.copy()
data_with_pca[[f'PC{i+1}' for i in range(n_components)]] = pca_df

# Save for next step
data_with_pca.to_csv('/content/data_step3_pca.csv')

# Print explained variance
print("✅ Step 3 completed.")
print("🔍 Explained variance ratio:", pca.explained_variance_ratio_)
