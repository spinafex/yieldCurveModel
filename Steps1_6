# --- 1. Load data ---
data = pd.read_csv('data.csv', parse_dates=['Date'])  # <-- make sure 'Date' is your datetime column
data = data.sort_values('Date').reset_index(drop=True)

# Define curve columns
curve_columns = [
    'ust1m', 'ust3m', 'ust6m', 'ust1y', 'ust2y', 'ust5y', 'ust7y', 'ust10y', 'ust20y', 'ust30y',
    'ss2', 'ss3', 'ss5', 'ss7', 'ss10', 'ss20', 'ss30',
    's1', 's2', 's3', 's5', 's7', 's10', 's20', 's30',
    'inf1y','inf2y','inf3y','inf5y','inf7y','inf10y','inf20y','inf30y',
    'be5','be10','be20','be30',
    'ry5', 'ry10', 'ry30'
]

# --- 2. Feature Engineering ---

# 2.1 Create target: 2s10s slope (ust10y - ust2y)
data['Current_Slope'] = data['ust10y'] - data['ust2y']

# 2.2 Predict Slope Change 5 days ahead
future_shift = 5
data['Future_Slope'] = data['Current_Slope'].shift(-future_shift)
data['Slope_Change'] = data['Future_Slope'] - data['Current_Slope']

# 2.3 Define dynamic thresholds for class assignment
lower = data['Slope_Change'].quantile(0.33)
upper = data['Slope_Change'].quantile(0.66)

data['Slope_Class'] = data['Slope_Change'].apply(
    lambda x: 'Steepen' if x > upper else ('Flatten' if x < lower else 'Unchanged')
)

# 🔍 Class distribution check
class_counts = data['Slope_Class'].value_counts(normalize=True)
print("\n📊 Class distribution:")
print(class_counts)

# 🔴 Warning if any class is under 10%
if (class_counts < 0.10).any():
    warnings.warn(f"⚠️ Class imbalance detected. One or more classes < 10% of samples.\n{class_counts.to_dict()}")

# 2.4 Lag all input features to avoid lookahead bias
for col in curve_columns:
    data[f'{col}_lagged'] = data[col].shift(future_shift)

# 2.5 Drop rows with NaNs caused by shifting
data = data.dropna().reset_index(drop=True)

