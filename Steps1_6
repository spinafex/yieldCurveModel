# Modified Step 4 for 1-Month Horizon (Alongside 6m/12m/18m If You Like)

import pandas as pd
import numpy as np

# Load PCA-enhanced features
data = pd.read_csv('/content/data_step3_pca.csv', parse_dates=['Date'])
data.set_index('Date', inplace=True)

# Target: Current 2s10s Slope
data['slope_now'] = data['ust10y'] - data['ust2y']

# Add 1-month to forecast horizons
forecast_horizons = {
    '1m': 21,        # ≈ 1 month
    '6m': 21 * 6,
    '12m': 21 * 12,
    '18m': 21 * 18
}

for label, shift in forecast_horizons.items():
    future_slope_col = f'slope_{label}_ahead'
    delta_col = f'delta_{label}'

    data[future_slope_col] = data['slope_now'].shift(-shift)
    data[delta_col] = data[future_slope_col] - data['slope_now']

    # Use dynamic thresholds for classification: 33rd and 66th percentiles
    lower = data[delta_col].quantile(0.33)
    upper = data[delta_col].quantile(0.66)

    data[f'class_{label}'] = np.select(
        [data[delta_col] > upper, data[delta_col] < lower],
        [1, -1],
        default=0
    )

# Drop rows with NaNs from lookahead shifts
data.dropna(inplace=True)

# Save dataset
data.to_csv('/content/data_step4_targets.csv')

print("✅ Step 4 completed with 1m, 6m, 12m, 18m targets.")
print("📊 Sample target columns:")
display(data[[col for col in data.columns if 'class' in col or 'delta' in col]].head())

